<fieldset class="tile-unlit-fieldset" data-fvtt-tile-unlit>
  <legend>{{ localize "TILEUNLIT.Category" }}</legend>

  <div class="form-group slim">
    <label>{{ localize "TILEUNLIT.IgnoreLighting" }}</label>
    <div class="form-fields">
      <range-picker
        name="flags.fvtt-tile-unlit.ignoreLighting"
        value="{{ value }}"
        min="0"
        max="1"
        step="0.05">
      </range-picker>
    </div>
    <p class="hint">{{ localize "TILEUNLIT.IgnoreLightingHint" }}</p>
  </div>

  <div class="form-group slim">
    <label>{{ localize "TILEUNLIT.IgnoreWeather" }}</label>
    <div class="form-fields">
      <range-picker
        name="flags.fvtt-tile-unlit.ignoreWeather"
        value="{{ weatherValue }}"
        min="0"
        max="1"
        step="0.05">
      </range-picker>
    </div>
    <p class="hint">{{ localize "TILEUNLIT.IgnoreWeatherHint" }}</p>
  </div>
</fieldset>
